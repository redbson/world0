# World 0 — environment template.
# Copy to `.env` (git-ignored) and fill in. `./start.sh` auto-loads `.env`.
#   cp .env.example .env
#
# Only set the provider credentials you actually use. The recommended
# default extraction model is gpt-5.4-nano via Azure OpenAI
# (see docs/extraction-model-prompt-eval.md).

# ── Launcher defaults (consumed by start.sh) ─────────────────────────
# Provider routing: none | azure-openai | openai | anthropic | claude | codex
WORLD0_PROVIDER=azure-openai
WORLD0_MODEL=gpt-5.4-nano
# Where the concept world is stored:
WORLD0_STORE=$HOME/.pkm_world
# WORLD0_SPACE=
WORLD0_HOST=127.0.0.1
WORLD0_PORT=8420
# pip extras installed by `./start.sh setup`:
WORLD0_EXTRAS=web,openai
# WORLD0_VENV=.venv
# WORLD0_PYTHON=python3.11

# ── Azure OpenAI (for GPT / DeepSeek / grok deployments) ─────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-azure-openai-key>
# AZURE_OPENAI_API_KEY=<alias accepted too>

# ── OpenAI (api.openai.com) ──────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Anthropic (Claude) ───────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Zhipu GLM (glm-5.1, OpenAI-compatible) ───────────────────────────
# GLM_API_KEY=...

# ── Optional outbound proxy (if your network needs one) ──────────────
# Use an HTTP proxy; a SOCKS proxy needs `pip install httpx[socks]`.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
